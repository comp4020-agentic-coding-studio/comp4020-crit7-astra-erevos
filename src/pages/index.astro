---
import { listPinnedFunctionIds } from "../lib/db";
import { CATEGORIES, COMMON_TASK_IDS, FUNCTIONS, FUNCTIONS_BY_ID } from "../lib/functions";
import { ensureVisitorId } from "../lib/visitor";
import FunctionCard from "../components/FunctionCard.astro";
import "../styles.css";

const visitorId = ensureVisitorId(Astro.cookies);
const pinnedIds = new Set(listPinnedFunctionIds(visitorId));
const pinnedFunctions = FUNCTIONS.filter((fn) => pinnedIds.has(fn.id));
const commonTasks = COMMON_TASK_IDS.map((id) => FUNCTIONS_BY_ID.get(id)).filter((fn) => fn !== undefined);
const sections = CATEGORIES.map((category) => ({
  category,
  functions: FUNCTIONS.filter((fn) => fn.category === category),
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANUHub</title>
  </head>
  <body>
    <header class="site-bar">
      <nav aria-label="site">
        <a href="/" class="brand">
          <span class="brand-org">ANU Student Administration</span>
          <span class="brand-product">ANUHub</span>
        </a>
        <a href="/readme/" class="about-link">About this build</a>
      </nav>
      <input
        type="search"
        id="search"
        placeholder="Search functions…"
        aria-label="Search functions"
      />
    </header>
    <main>
      <h1>ANUHub</h1>

      <section id="search-results" class="search-results" aria-live="polite" hidden>
        <p class="result-count" id="result-count"></p>
        <div class="shelf-grid" id="result-grid"></div>
      </section>

      <p class="intro hide-on-search">
        Student functions, organised by what you're trying to do — not by
        which system owns them. Search to jump straight to one, or pin your
        most-used functions so they're the first thing you see next time.
      </p>

      <section
        aria-label="Pinned"
        id="shelf"
        class:list={["shelf", "hide-on-search", { "shelf-empty": pinnedFunctions.length === 0 }]}
      >
        <h2>Pinned</h2>
        <div id="shelf-content" aria-live="polite">
          {
            pinnedFunctions.length === 0 ? (
              <p class="empty" id="shelf-empty">
                Nothing pinned yet — star a function below to add it here.
              </p>
            ) : (
              <div class="shelf-grid" id="shelf-grid">
                {pinnedFunctions.map((fn) => (
                  <FunctionCard fn={fn} pinned={true} />
                ))}
              </div>
            )
          }
        </div>
      </section>

      <section aria-label="Quick access" class="common-tasks hide-on-search">
        <h2>Quick access</h2>
        <p class="section-note">
          The student tasks people reach for most — each one still lives in its category below.
        </p>
        <div class="shelf-grid">
          {commonTasks.map((fn) => <FunctionCard fn={fn} pinned={pinnedIds.has(fn.id)} />)}
        </div>
      </section>

      <h2 class="catalog-heading hide-on-search">Full catalog</h2>
      {
        sections.map(({ category, functions }) => (
          <details class="category hide-on-search" open>
            <summary>
              <h3>
                {category} <span class="count-badge">{functions.length}</span>
              </h3>
            </summary>
            <div class="row-list">
              {functions.map((fn) => (
                <FunctionCard fn={fn} pinned={pinnedIds.has(fn.id)} variant="row" />
              ))}
            </div>
          </details>
        ))
      }
    </main>

    <script type="application/json" id="catalog" is:inline set:html={JSON.stringify(FUNCTIONS)} />

    <script>
      // Pin toggle: progressively enhance every pin form (grid, shelf, and
      // search results alike) with an optimistic, no-reload update; fall
      // back to the plain POST + redirect if JS never runs at all.
      interface CatalogFunction {
        id: string;
        name: string;
        description: string;
        category: string;
        icon: string;
      }

      const catalogEl = document.querySelector("#catalog");
      const catalog: CatalogFunction[] = catalogEl ? JSON.parse(catalogEl.textContent ?? "[]") : [];
      const byId = new Map(catalog.map((fn) => [fn.id, fn]));

      function isPinned(functionId: string): boolean {
        return document.querySelector(`.pin-button[data-function-id="${functionId}"]`)?.getAttribute(
          "aria-pressed",
        ) === "true";
      }

      function setButtonState(button: Element, pinned: boolean) {
        button.setAttribute("aria-pressed", pinned ? "true" : "false");
        button.textContent = pinned ? "★ Pinned" : "☆ Pin";
      }

      function buildCard(fn: CatalogFunction, pinned: boolean): HTMLElement {
        const article = document.createElement("article");
        article.className = "card";
        article.dataset.functionId = fn.id;
        article.dataset.variant = "card";
        article.dataset.search = `${fn.name} ${fn.description} ${fn.category}`.toLowerCase();

        const icon = document.createElement("div");
        icon.className = "card-icon";
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = fn.icon;

        const body = document.createElement("div");
        body.className = "card-body";
        const heading = document.createElement("h3");
        heading.textContent = fn.name;
        const description = document.createElement("p");
        description.textContent = fn.description;
        body.append(heading, description);

        const form = document.createElement("form");
        form.method = "post";
        form.action = "/api/pins";
        form.className = "pin-form";
        const hiddenInput = document.createElement("input");
        hiddenInput.type = "hidden";
        hiddenInput.name = "function_id";
        hiddenInput.value = fn.id;
        const button = document.createElement("button");
        button.type = "submit";
        button.className = "pin-button";
        button.dataset.functionId = fn.id;
        setButtonState(button, pinned);
        form.append(hiddenInput, button);

        article.append(icon, body, form);
        return article;
      }

      function getShelfGrid(): HTMLElement | null {
        const existing = document.querySelector<HTMLElement>("#shelf-grid");
        if (existing) return existing;
        const content = document.querySelector<HTMLElement>("#shelf-content");
        if (!content) return null;
        content.replaceChildren();
        const grid = document.createElement("div");
        grid.className = "shelf-grid";
        grid.id = "shelf-grid";
        content.appendChild(grid);
        return grid;
      }

      function addToShelf(fn: CatalogFunction) {
        const grid = getShelfGrid();
        if (!grid || grid.querySelector(`[data-function-id="${fn.id}"]`)) return;
        grid.prepend(buildCard(fn, true));
        document.querySelector("#shelf")?.classList.remove("shelf-empty");
      }

      function removeFromShelf(functionId: string) {
        const grid = document.querySelector<HTMLElement>("#shelf-grid");
        grid?.querySelector(`[data-function-id="${functionId}"]`)?.remove();
        if (grid && grid.children.length === 0) {
          const content = document.querySelector<HTMLElement>("#shelf-content");
          if (content) {
            content.replaceChildren();
            const empty = document.createElement("p");
            empty.className = "empty";
            empty.id = "shelf-empty";
            empty.textContent = "Nothing pinned yet — star a function below to add it here.";
            content.appendChild(empty);
          }
          document.querySelector("#shelf")?.classList.add("shelf-empty");
        }
      }

      function applyPinState(functionId: string, pinned: boolean) {
        for (const button of document.querySelectorAll(`.pin-button[data-function-id="${functionId}"]`)) {
          setButtonState(button, pinned);
        }
        const fn = byId.get(functionId);
        if (!fn) return;
        if (pinned) addToShelf(fn);
        else removeFromShelf(functionId);
      }

      document.addEventListener("submit", async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.classList.contains("pin-form")) return;
        event.preventDefault();

        const functionId = String(new FormData(form).get("function_id") ?? "");
        if (!byId.has(functionId)) return;

        const button = form.querySelector(".pin-button");
        const wasPinned = button?.getAttribute("aria-pressed") === "true";
        const nextPinned = !wasPinned;
        applyPinState(functionId, nextPinned);

        try {
          const res = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { accept: "application/json" },
          });
          if (!res.ok) throw new Error(`status ${res.status}`);
          const data: { functionId: string; pinned: boolean } = await res.json();
          applyPinState(data.functionId, data.pinned);
        } catch {
          applyPinState(functionId, wasPinned);
        }
      });

      // Instant, client-side search: the whole catalog is small and already
      // in memory, so filtering is just an array scan, never a network
      // request. A non-empty query switches the page into a dedicated
      // search-results mode — matches appear right under the search box
      // with a count, and the normal homepage sections (Pinned, Common
      // tasks, the full catalog) are hidden until the query is cleared.
      const searchInput = document.querySelector<HTMLInputElement>("#search");
      const resultsSection = document.querySelector<HTMLElement>("#search-results");
      const resultCount = document.querySelector<HTMLElement>("#result-count");
      const resultGrid = document.querySelector<HTMLElement>("#result-grid");
      const hideOnSearch = document.querySelectorAll<HTMLElement>(".hide-on-search");

      searchInput?.addEventListener("input", () => {
        const query = searchInput.value.trim();
        const searching = query.length > 0;

        for (const el of hideOnSearch) el.hidden = searching;
        if (resultsSection) resultsSection.hidden = !searching;

        if (!searching) {
          resultGrid?.replaceChildren();
          if (resultCount) resultCount.textContent = "";
          return;
        }

        const lower = query.toLowerCase();
        const matches = catalog.filter((fn) =>
          `${fn.name} ${fn.description} ${fn.category}`.toLowerCase().includes(lower),
        );

        if (resultCount) {
          resultCount.textContent =
            matches.length === 0
              ? `No results for "${query}"`
              : `${matches.length} result${matches.length === 1 ? "" : "s"} for "${query}"`;
        }
        resultGrid?.replaceChildren(...matches.map((fn) => buildCard(fn, isPinned(fn.id))));
      });
    </script>
  </body>
</html>
